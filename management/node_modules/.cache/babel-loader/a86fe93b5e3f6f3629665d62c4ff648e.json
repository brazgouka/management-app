tDefault()\n        \n        this.form.name = ''\n        this.form.amount = ''\n        this.form.recordType = null\n        this.form.approved = \"false\"\n        \n        this.show = false\n        this.$nextTick(() => {\n          this.show = true\n        })\n      }\n    }\n  }\n</script>"],"sourceRoot":"src/components/tabs"}]}