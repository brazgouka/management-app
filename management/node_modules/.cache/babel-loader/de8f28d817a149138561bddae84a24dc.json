utes > 0 ? minutes : 0;\n      } else {\n        return 0;\n      }\n    }\n  },\n  methods: {\n    startInterval: function startInterval() {\n      this.pause = false;\n      var self = this;\n      setInterval(function () {\n        if (!self.pause) {\n          self.now = Math.trunc(new Date().getTime() / 1000);\n        }\n      }, 1000);\n    },\n    stopTimer: function stopTimer() {\n      this.pause = true;\n      this.audio.pause();\n    },\n    onSubmit: function onSubmit(evt) {\n      evt.preventDefault();\n      this.endTime = this.now + parseInt(this.countdown) * 60;\n    }\n  }\n};",{"version":3,"sources":["Countdown.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;AAwBA,eAAA;AAEA,EAAA,IAFA,kBAEA;AACA,WAAA;AACA,MAAA,KAAA,EAAA,IADA;AAEA,MAAA,KAAA,EAAA,IAAA,KAAA,CAAA,4EAAA,CAFA;AAGA,MAAA,OAAA,EAAA,MAHA;AAIA,MAAA,SAAA,EAAA,IAJA;AAKA,MAAA,UAAA,EAAA,CAAA,GAAA,EAAA,GAAA,EAAA,IAAA,EAAA,IAAA,EAAA,IAAA,CALA;AAMA,MAAA,GAAA,EAAA,IAAA,CAAA,KAAA,CAAA,IAAA,IAAA,EAAA,CAAA,OAAA,KAAA,IAAA;AANA,KAAA;AAQA,GAXA;AAaA,EAAA,QAAA,EAAA;AACA,IAAA,OADA,qBACA;AACA,UAAA,CAAA,KAAA,KAAA,EAAA;AACA,YAAA,OAAA,GAAA,IAAA,CAAA,KAAA,CAAA,KAAA,OAAA,GAAA,KAAA,GAAA,IAAA,EAAA;;AACA,YAAA,OAAA,IAAA,CAAA,IAAA,KAAA,OAAA,IAAA,CAAA,EAAA;AACA,eAAA,KAAA,CAAA,IAAA;AACA;;AACA,eAAA,OAAA,GAAA,CAAA,GAAA,OAAA,GAAA,CAAA;AACA,OANA,MAMA;AACA,eAAA,CAAA;AACA;AACA,KAXA;AAaA,IAAA,OAbA,qBAaA;AACA,UAAA,CAAA,KAAA,KAAA,EAAA;AACA,YAAA,OAAA,GAAA,IAAA,CAAA,KAAA,CAAA,CAAA,KAAA,OAAA,GAAA,KAAA,GAAA,IAAA,EAAA,IAAA,EAAA;AACA,eAAA,OAAA,GAAA,CAAA,GAAA,OAAA,GAAA,CAAA;AACA,OAHA,MAGA;AACA,eAAA,CAAA;AACA;AACA;AApBA,GAbA;AAoCA,EAAA,OAAA,EAAA;AACA,IAAA,aAAA,EAAA,yBAAA;AACA,WAAA,KAAA,GAAA,KAAA;AACA,UAAA,IAAA,GAAA,IAAA;AACA,MAAA,WAAA,CAAA,YAAA;AACA,YAAA,CAAA,IAAA,CAAA,KAAA,EAAA;AACA,UAAA,IAAA,CAAA,GAAA,GAAA,IAAA,CAAA,KAAA,CAAA,IAAA,IAAA,EAAA,CAAA,OAAA,KAAA,IAAA,CAAA;AACA;AACA,OAJA,EAIA,IAJA,CAAA;AAKA,KATA;AAUA,IAAA,SAAA,EAAA,qBAAA;AACA,WAAA,KAAA,GAAA,IAAA;AACA,WAAA,KAAA,CAAA,KAAA;AACA,KAbA;AAcA,IAAA,QAdA,oBAcA,GAdA,EAcA;AACA,MAAA,GAAA,CAAA,cAAA;AACA,WAAA,OAAA,GAAA,KAAA,GAAA,GAAA,QAAA,CAAA,KAAA,SAAA,CAAA,GAAA,EAAA;AACA;AAjBA;AApCA,CAAA","sourcesContent":["<template>\n    <div>\n        <b-form @submit=\"onSubmit\">\n            <b-form-group class=\"form-grp\" label-align=\"center\" label=\"Countdown:\" label-for=\"input-3\">\n                <b-form-select\n                    v-model=\"countdown\"\n                    :options=\"countdowns\"\n                    required></b-form-select>\n            </b-form-group>\n            <b-button class=\"timer-btn\" @click=\"startInterval\" type=\"submit\" variant=\"primary\">Submit</b-button>\n            <b-button class=\"timer-btn\" @click=\"stopTimer\" type=\"cancel\" variant=\"danger\">Stop</b-button>\n        </b-form>\n        <div class=\"d-inline-block block\">\n            <p class=\"digit\">{{ minutes | two_digits }}</p>\n            <p class=\"text\">Minutes</p>\n        </div>\n        <div class=\"d-inline-block block\">\n            <p class=\"digit\">{{ seconds | two_digits }}</p>\n            <p class=\"text\">Seconds</p>\n        </div>\n    </div>\n</template>\n\n<script>\nexport default {\n\n    data() {\n        return {\n            pause: true,\n            audio: new Audio('https://interactive-examples.mdn.mozilla.net/media/examples/t-rex-roar.mp3'),\n            endTime: Number,\n            countdown: '25',\n            countdowns: ['1', '5', '15', '25', '55'],\n            now: Math.trunc((new Date()).getTime() / 1000)\n        }\n    },\n\n    computed: {\n        seconds() {\n            if(!this.pause) { \n                let seconds = Math.trunc((this.endTime - this.now)) % 60;\n                if (seconds <= 0 && this.minutes <= 0) {\n                    this.audio.play();\n                }\n                return  seconds > 0 ? seconds : 0;\n            } else {\n                return 0;\n            }\n        },\n\n        minutes() {\n            if(!this.pause) { \n                let minutes = Math.trunc((this.endTime - this.now) / 60) % 60;\n                return minutes > 0 ? minutes : 0;\n            } else {\n                return 0;\n            }\n        }\n    },\n\n    methods: {\n        startInterval: function () {\n            this.pause = false; \n            const self = this;\n            setInterval(function() {\n                if(!self.pause) { \n                    self.now = Math.trunc((new Date()).getTime() / 1000);\n                }\n            }, 1000); \n        },\n        stopTimer: function () {\n            this.pause = true;\n            this.audio.pause();\n        },\n        onSubmit(evt) {\n            evt.preventDefault()\n            this.endTime = this.now + parseInt(this.countdown) * 60;\n        }\n    }\n}\n</script>\n\n<style scoped>\n    @import url(https://fonts.googleapis.com/css?family=Roboto+Condensed:400|Roboto:100);\n\n    .timer-btn {\n        margin: 5px;\n        margin-bottom: 0px;\n    }\n\n    .form-grp {\n        width: 170px;\n        margin: auto;\n        margin-top: 100px;\n        margin-bottom: 10px;\n    }\n\n    .block {\n        flex-direction: column;\n        margin: 30px;\n        margin-top: 10px;\n    }\n\n    .text {\n        color: rgb(139, 176, 255);\n        font-size: 30px;\n        font-family: 'Roboto Condensed', serif;\n        font-weight: 40;\n        margin-top:10px;\n        margin-bottom: 10px;\n    }\n\n    .digit {\n        color: #ecf0f1;\n        font-size: 100px;\n        font-weight: 100;\n        font-family: 'Roboto', serif;\n        margin: 10px;\n    }\n</style>"],"sourceRoot":"src/components/tabs"}]}